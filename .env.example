DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/pharmeasy?schema=public"
DIRECT_URL="postgresql://postgres:yourpassword@localhost:5432/pharmeasy?schema=public"
JWT_SECRET="replace-with-any-long-random-string"
SCHEDULER_SECRET="replace-with-any-long-random-string"

# Brevo (Sendinblue) transactional email — used for payment receipts,
# password reset OTP, and refill reminder emails.
# Get an API key at https://app.brevo.com/settings/keys/api

BREVO_API_KEY="replace-with-your-brevo-api-key"

# Must be a sender email address verified in your Brevo account.

MAIL="replace-with-your-verified-sender-email@example.com"